# ==============================================================================
# FİNCAN SOHBET — ÖRNEK ORTAM DEĞİŞKENLERİ (.env.example)
# ==============================================================================
# Gerçek değerlerinizi .env veya .env.local dosyasına kopyalayarak girin.
# Bu değişkenler girilmediğinde uygulama otomatik olarak yerel demo modunda çalışır.

# Supabase Proje Bilgileri (Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Canlı Alan Adı (QR kodlarında ve kalıcı masa bağlantılarında kullanılan kök URL)
# Tanımlanmadığında tarayıcının o anki window.location.origin değeri kullanılır.
VITE_APP_URL=https://fincansohbet.com

# Merkezi İletişim Bilgileri (İsteğe bağlı)
VITE_CONTACT_EMAIL=iletisim@fincansohbet.com
VITE_CONTACT_PHONE=+90 (850) 000 00 00

# Çevrimdışı / Demo Modu Zorlama (true | false)
VITE_DEMO_MODE=false
